# Public (safe for browser)
PUBLIC_SUPABASE_URL=your-supabase-url
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
PUBLIC_EASEBUZZ_KEY=your-easebuzz-key
PUBLIC_EASEBUZZ_MODE=sandbox

# Company identity (used on GST invoices)
PUBLIC_COMPANY_GSTIN=your-gstin
PUBLIC_COMPANY_NAME=Clean Agritech Pvt. Ltd.
PUBLIC_COMPANY_ADDRESS=Tamil Nadu, India

# Server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EASEBUZZ_SALT=your-easebuzz-salt
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
ASTRO_KEY=generated-by-astro-create-key
