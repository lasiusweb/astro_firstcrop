---
const steps = [
  { num: '01', title: 'Choose Your Bio', desc: 'Browse our lab-tested range of soil treatments, crop protectors, and bio-fertilizers.' },
  { num: '02', title: 'Apply Simply', desc: 'Follow clear application rates. Most products mix with water or soil — no special equipment needed.' },
  { num: '03', title: 'Watch Results', desc: 'See visible improvements in 2-4 weeks. Healthier soil, stronger roots, better yields.' },
];
---

<section class="how-it-works">
  <div class="container">
    <h2 class="section-title heading-display">How It Works</h2>
    <div class="steps-grid">
      {steps.map(step => (
        <div class="step">
          <span class="step-num">{step.num}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding: var(--space-16) 0;
    background: var(--c-green-50);
  }
  .section-title {
    text-align: center;
    margin-bottom: var(--space-10);
    color: var(--c-gray-900);
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
  }
  .step {
    text-align: center;
    padding: var(--space-6);
  }
  .step-num {
    display: inline-block;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--c-green-600);
    line-height: 1;
    margin-bottom: var(--space-4);
    opacity: 0.3;
  }
  .step-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--c-gray-900);
    margin-bottom: var(--space-2);
  }
  .step-desc {
    font-size: 0.9375rem;
    color: var(--c-gray-600);
    line-height: 1.6;
  }
</style>
