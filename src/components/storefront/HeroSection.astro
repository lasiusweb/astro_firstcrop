---
---

<section class="hero">
  <div class="hero-bg">
    <img
      src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1600&q=80"
      alt="Lush green farm field"
      width="1600"
      height="800"
      fetchpriority="high"
      class="hero-image"
    />
    <div class="hero-scim"></div>
  </div>
  <div class="container hero-content">
    <span class="hero-tag">Micro-Microbial Biologicals</span>
    <h1 class="hero-title heading-display">Grow Smarter,<br/>Grow Natural</h1>
    <p class="hero-desc">Lab-tested bio-solutions for healthier soil, stronger crops, and better yields. Trusted by 10,000+ Indian farmers.</p>
    <div class="hero-actions">
      <a href="/products" class="hero-cta hero-cta-primary">Shop All Products</a>
      <a href="/learn" class="hero-cta hero-cta-secondary">How It Works</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 60vh;
    min-height: 400px;
    max-height: 600px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  @media (max-width: 767px) {
    .hero { height: 50vh; min-height: 350px; }
  }
  .hero-bg {
    position: absolute;
    inset: 0;
  }
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.1) 50%, transparent 100%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-10);
    color: var(--c-white);
    max-width: 600px;
  }
  .hero-tag {
    display: inline-block;
    background: var(--c-green-600);
    color: var(--c-white);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hero-title {
    margin-bottom: var(--space-3);
  }
  .hero-desc {
    font-size: 1.0625rem;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: var(--space-6);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background var(--dur-base) var(--ease-out), transform var(--dur-micro) var(--ease-out);
    min-height: 44px;
  }
  .hero-cta:active {
    transform: scale(0.97);
  }
  .hero-cta-primary {
    background: var(--c-green-600);
    color: var(--c-white);
  }
  .hero-cta-primary:hover {
    background: var(--c-green-700);
  }
  .hero-cta-secondary {
    background: rgba(255,255,255,0.15);
    color: var(--c-white);
    border: 1px solid rgba(255,255,255,0.3);
    backdrop-filter: blur(8px);
  }
  .hero-cta-secondary:hover {
    background: rgba(255,255,255,0.25);
  }
</style>
