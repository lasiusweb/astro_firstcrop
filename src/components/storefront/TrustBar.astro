---
const items = [
  { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', label: 'Lab Tested' },
  { icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z', label: 'Farmer Approved' },
  { icon: 'M5 13l4 4L19 7', label: 'Organic Certified' },
  { icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z', label: 'Free Shipping ₹500+' },
];
---

<section class="trust-bar">
  <div class="container trust-bar-inner">
    {items.map(item => (
      <div class="trust-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg>
        <span class="trust-label">{item.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-bar {
    border-bottom: 1px solid var(--c-gray-100);
    padding: var(--space-4) 0;
  }
  .trust-bar-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    overflow-x: auto;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    color: var(--c-green-700);
    flex-shrink: 0;
  }
  .trust-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--c-gray-700);
  }
</style>
