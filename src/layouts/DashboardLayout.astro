---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/admin/orders', label: 'Orders', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
  { href: '/admin/products', label: 'Products', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { href: '/admin/settings', label: 'Settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
];
---

<BaseLayout title={`Admin — ${title}`}>
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="admin-sidebar">
      <div class="sidebar-header">
        <a href="/admin" class="sidebar-logo">Firstcrop</a>
        <button id="sidebar-toggle" aria-label="Toggle sidebar" class="sidebar-toggle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
      </div>
      <nav class="sidebar-nav" aria-label="Admin navigation">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={['sidebar-link', { active: currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href)) }]}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg>
            <span class="sidebar-label">{item.label}</span>
          </a>
        ))}
      </nav>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">
      <header class="admin-topbar">
        <h1 class="admin-page-title">{title}</h1>
        <div class="admin-topbar-actions">
          <a href="/" class="admin-topbar-link" target="_blank">View Store ↗</a>
        </div>
      </header>
      <div class="admin-content">
        <slot />
      </div>
    </div>
  </div>

  <script>
    const sidebar = document.getElementById('admin-sidebar');
    const toggle = document.getElementById('sidebar-toggle');
    toggle?.addEventListener('click', () => {
      sidebar?.classList.toggle('collapsed');
    });
  </script>
</BaseLayout>

<style>
  .admin-layout {
    display: flex;
    min-height: 100vh;
    background: var(--d-bg);
  }

  .admin-sidebar {
    width: var(--d-sidebar-width);
    background: var(--d-surface);
    border-right: 1px solid var(--d-border);
    display: flex;
    flex-direction: column;
    transition: width var(--dur-base) var(--ease-out);
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
  }

  .admin-sidebar.collapsed {
    width: var(--d-sidebar-collapsed);
  }

  .admin-sidebar.collapsed .sidebar-label,
  .admin-sidebar.collapsed .sidebar-logo {
    display: none;
  }

  .admin-sidebar.collapsed .sidebar-toggle svg {
    transform: rotate(180deg);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    border-bottom: 1px solid var(--d-border);
    height: 56px;
  }

  .sidebar-logo {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--d-accent);
  }

  .sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    color: var(--d-text-secondary);
    transition: background var(--dur-micro) var(--ease-out);
  }

  .sidebar-toggle:hover {
    background: var(--d-border);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-2);
    gap: 2px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    color: var(--d-text-secondary);
    transition: background var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }

  .sidebar-link:hover {
    background: var(--d-border);
    color: var(--d-text);
  }

  .sidebar-link.active {
    background: var(--d-accent-light);
    color: var(--d-accent);
  }

  .admin-main {
    flex: 1;
    margin-left: var(--d-sidebar-width);
    transition: margin-left var(--dur-base) var(--ease-out);
    display: flex;
    flex-direction: column;
  }

  .admin-sidebar.collapsed ~ .admin-main {
    margin-left: var(--d-sidebar-collapsed);
  }

  .admin-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    background: var(--d-surface);
    border-bottom: 1px solid var(--d-border);
    height: 56px;
  }

  .admin-page-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--d-text);
  }

  .admin-topbar-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--d-text-secondary);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .admin-topbar-link:hover {
    color: var(--d-accent);
  }

  .admin-content {
    padding: var(--space-6);
    flex: 1;
  }

  @media (max-width: 767px) {
    .admin-sidebar {
      display: none;
    }

    .admin-main {
      margin-left: 0;
    }
  }
</style>
