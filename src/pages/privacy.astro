---
import StorefrontLayout from '../layouts/StorefrontLayout.astro';

export const prerender = true;
---

<StorefrontLayout title="Privacy Policy — Firstcrop">
  <div class="container legal-page">
    <h1>Privacy Policy</h1>
    <p class="legal-updated">Last updated: August 2026</p>
    <div class="legal-body">
      <h2>What we collect</h2>
      <p>We collect your phone number (for login via OTP), delivery address and order history (to fulfil orders), and basic usage data (to improve the store).</p>
      <h2>How we use it</h2>
      <p>Your phone number is used only for authentication and order updates. Your address is shared with our logistics partners solely to deliver your order. We never sell your data.</p>
      <h2>Payments</h2>
      <p>Payments are processed by Easebuzz. We never see or store your card, UPI, or bank credentials.</p>
      <h2>Data retention & deletion</h2>
      <p>You may request deletion of your account and personal data by writing to privacy@firstcrop.in. Order records may be retained as required by Indian tax law.</p>
      <h2>Contact</h2>
      <p>Questions? Write to privacy@firstcrop.in.</p>
    </div>
  </div>
</StorefrontLayout>

<style>
  .legal-page { padding: var(--space-10) var(--space-4); max-width: 720px; margin-inline: auto; }
  h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: var(--space-1); }
  .legal-updated { color: var(--c-gray-400); font-size: 0.875rem; margin-bottom: var(--space-6); }
  .legal-body :global(h2) { font-size: 1rem; font-weight: 700; margin: var(--space-5) 0 var(--space-2); }
  .legal-body :global(p) { color: var(--c-gray-600); line-height: 1.7; }
</style>