---
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<StorefrontLayout title="Blog — Firstcrop" description="Farming guides, soil health insights, and farmer success stories.">
  <div class="container blog-page">
    <header class="blog-header">
      <h1 class="blog-title">From the Field</h1>
      <p class="blog-desc">Soil health guides, application tips, and stories from Indian farmers.</p>
    </header>
    <div class="blog-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="blog-row">
          <span class="blog-tag">{post.data.tag}</span>
          <h2 class="blog-row-title">{post.data.title}</h2>
          <p class="blog-row-desc">{post.data.description}</p>
          <time class="blog-date" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  </div>
</StorefrontLayout>

<style>
  .blog-page { padding: var(--space-8) var(--space-4); max-width: 800px; margin-inline: auto; }
  .blog-title { font-size: 1.75rem; font-weight: 700; }
  .blog-desc { color: var(--c-gray-600); margin: var(--space-2) 0 var(--space-8); }
  .blog-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .blog-row {
    display: block;
    border: 1px solid var(--c-gray-100);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: border-color var(--dur-micro) var(--ease-out);
  }
  .blog-row:hover { border-color: var(--c-green-500); }
  .blog-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-green-700);
    background: var(--c-green-50);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }
  .blog-row-title { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--space-1); }
  .blog-row-desc { color: var(--c-gray-600); font-size: 0.9375rem; margin-bottom: var(--space-2); }
  .blog-date { font-size: 0.8125rem; color: var(--c-gray-400); }
</style>