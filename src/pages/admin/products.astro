---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getClaims } from '../../lib/auth/get-claims';

const claims = await getClaims(Astro);
if (!claims || claims.role !== 'admin') {
  return Astro.redirect('/auth/login');
}
---

<DashboardLayout title="Products — Firstcrop Admin">
  <div class="admin-products">
    <header class="page-header">
      <h1 class="page-title">Products</h1>
    </header>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th class="text-right">Price</th>
            <th class="text-right">Stock</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="products-tbody">
          <tr><td colspan="6" class="loading-text">Loading&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    async function loadProducts() {
      try {
        const res = await fetch('/api/admin/products');
        const { products } = await res.json();
        const tbody = document.getElementById('products-tbody')!;
        if (!products?.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="empty-text">No products found.</td></tr>';
          return;
        }
        tbody.innerHTML = products.map((p: any) => `
          <tr data-id="${p.id}">
            <td>
              <div class="product-cell">
                <img src="${p.images?.[0] || ''}" alt="" width="40" height="40" class="product-thumb" />
                <div>
                  <span class="product-name">${p.name}</span>
                  <span class="product-slug">${p.slug}</span>
                </div>
              </div>
            </td>
            <td>${p.category_name || '\u2014'}</td>
            <td class="text-right numeric">\u20B9${p.price}</td>
            <td class="text-right numeric">${p.stock_qty ?? '\u2014'}</td>
            <td><span class="status-badge status-${p.status}">${p.status}</span></td>
            <td>
              <button class="action-btn" data-action="${p.status === 'active' ? 'archive' : 'activate'}">
                ${p.status === 'active' ? 'Archive' : 'Activate'}
              </button>
            </td>
          </tr>
        `).join('');
      } catch { console.error('Failed to load products'); }
    }

    document.getElementById('products-tbody')?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
      if (!btn) return;
      const row = btn.closest<HTMLTableRowElement>('tr')!;
      const productId = row.dataset.id!;
      const nextStatus = btn.dataset.action === 'archive' ? 'archived' : 'active';
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/products', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: productId, status: nextStatus }),
        });
        if (res.ok) {
          loadProducts();
        } else {
          const { error } = await res.json();
          alert(error || 'Update failed');
          btn.disabled = false;
        }
      } catch {
        alert('Update failed');
        btn.disabled = false;
      }
    });

    loadProducts();
  </script>
</DashboardLayout>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); }
  .page-title { font-size: 1.25rem; font-weight: 600; }
  .table-wrap { background: var(--c-white); border: 1px solid var(--c-gray-100); border-radius: var(--radius-lg); overflow-x: auto; }
  .data-table { width: 100%; border-collapse: collapse; }
  .data-table th { text-align: left; font-size: 0.6875rem; font-weight: 600; color: var(--c-gray-500); text-transform: uppercase; letter-spacing: 0.05em; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--c-gray-100); background: var(--c-gray-50); white-space: nowrap; }
  .data-table td { padding: var(--space-3) var(--space-4); font-size: 0.8125rem; border-bottom: 1px solid var(--c-gray-50); }
  .data-table tr:last-child td { border-bottom: none; }
  .text-right { text-align: right; }
  .product-cell { display: flex; align-items: center; gap: var(--space-2); }
  .product-thumb { border-radius: var(--radius-sm); object-fit: cover; background: var(--c-gray-100); }
  .product-name { display: block; font-weight: 500; }
  .product-slug { display: block; font-size: 0.75rem; color: var(--c-gray-500); }
  .status-badge { display: inline-block; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; padding: 2px 8px; border-radius: var(--radius-full); }
  .status-active { background: var(--c-green-50, #dcfce7); color: var(--c-green-700); }
  .status-draft { background: var(--c-gray-100); color: var(--c-gray-600); }
  .loading-text, .empty-text { text-align: center; color: var(--c-gray-500); padding: var(--space-6); }
  .action-btn {
    padding: 4px 10px;
    border: 1px solid var(--c-gray-200);
    border-radius: var(--radius-sm, 6px);
    background: var(--c-white);
    color: var(--c-gray-700);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 150ms ease-out;
  }
  .action-btn:hover { background: var(--c-gray-50); }
  .action-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
